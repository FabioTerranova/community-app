# community-app — Umgebungsvariablen (Vorlage)
# Echte Werte NICHT hier eintragen, sondern bei Vercel als Environment Variables
# (Settings -> Environment Variables) bzw. lokal in einer .env (ist gitignored).

# --- Notion (Datenbank/Backend) ---
# Integrations-Token ("Internal Integration Secret") aus notion.so -> My integrations.
# Die Notion-Datenbanken muessen mit dieser Integration GETEILT sein (••• -> Verbindungen).
NOTION_TOKEN=

# Optional: feste Datenbank-IDs; sonst werden sie ueber die Integration per Suche gefunden.
NOTION_MEMBERS_DB_ID=
NOTION_EVENTS_DB_ID=
NOTION_ATTENDANCE_DB_ID=

# --- Resend (News-/E-Mail-Versand) ---
# API-Key aus resend.com. Solange die Absender-Domain nicht verifiziert ist,
# nur an die eigene Adresse senden (Test-Modus, siehe NEWS_TEST_TO).
RESEND_API_KEY=
# Absender der News-Mails (nach Domain-Verifizierung z.B. news@deine-domain.tld)
NEWS_FROM=onboarding@resend.dev
# TESTMODUS: wenn gesetzt, gehen ALLE News nur an diese eine Adresse
# (bis die Absender-Domain in Resend verifiziert ist). Zum Livegang leeren/loeschen.
NEWS_TEST_TO=

# --- Frontend (nur fuer die native App / Expo Go noetig) ---
# Volle Deploy-URL, damit die App im Handy die api/-Endpunkte erreicht.
# Im Web leer lassen (dann laufen die Calls relativ ueber dieselbe Domain).
EXPO_PUBLIC_API_BASE=
